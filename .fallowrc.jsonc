{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/web/src/start.ts",
    "apps/app/src/main.tsx",
    "apps/app/server.ts",
    "apps/app/vite.config.ts",
    // TanStack Start loads the router itself and the route files through the generated route tree
    "apps/preview-ui/src/router.tsx",
    "apps/preview-ui/src/routes/**/*.tsx",
    "apps/preview-ui/vite.config.ts",
    "apps/desktop/src/main/index.ts",
    "apps/desktop/src/preload/index.ts",
    "apps/desktop/electrobun.config.ts",
    "scripts/*.ts",
    "packages/i18n/**/*.ts"
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/*.d.ts",
    "**/*.gen.*",
    // Vendored agent skills are managed by the `skills` CLI
    ".agents/skills/**",
    ".claude/skills/**"
  ],
  "ignoreDependencies": [
    // Type definitions and other packages that are not directly imported, but used
    "@types/node",
    "@dotenvx/dotenvx",
    // Required for React Compiler, https://github.com/vitejs/vite-plugin-react/blob/main/packages/plugin-react/README.md#react-compiler
    "babel-plugin-react-compiler",
    // Linting packages that are not directly imported, but used
    "@tanstack/eslint-plugin-query",
    "@tanstack/eslint-plugin-router",
    "eslint-plugin-fsd-lint",
    "eslint-plugin-react-hooks",
    // Consumed as a build output, not imported: apps/desktop copies its dist/desktop, apps/web serves its dist/web
    "@uni-stack/app",
    // Tooling invoked from package scripts instead of imported by source files
    "oxfmt",
    "oxlint"
  ],
  "ignoreExports": [{ "file": "**/*.mdx", "exports": ["*"] }],
  "ignoreExportsUsedInFile": true,
  "dynamicallyLoaded": ["src/plugins/**/*.ts"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "off",
    // Opt-in API hygiene check; default is "off"
    "private-type-leaks": "off",
    "unresolved-imports": "error"
  },
  "duplicates": {
    "ignore": ["**/__tests__/**", "**/__e2e/**", "**/*.test.*", "**/*.spec.*"],
    "mode": "mild",
    "minTokens": 40,
    "minLines": 5,
    "threshold": 20,
    "skipLocal": true,
    "ignoreImports": true
  },
  "audit": {
    "gate": "new-only"
  },
  "production": false
}
