{
  "name": "@uni-stack/desktop",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts"
  },
  "scripts": {
    "postinstall": "electrobun prepare",
    "dev:desktop": "electrobun dev --watch",
    "build:canary": "pnpm --dir ../.. --filter @uni-stack/app run build:desktop && electrobun build --env=canary",
    "build:stable": "pnpm --dir ../.. --filter @uni-stack/app run build:desktop && electrobun build --env=stable",
    "typecheck": "electrobun prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@tanstack/db": "catalog:",
    "@tanstack/db-sqlite-persistence-core": "catalog:",
    "@tanstack/electron-db-sqlite-persistence": "catalog:",
    "@types/bun": "catalog:",
    "@uni-stack/app": "workspace:*",
    "@uni-stack/tsconfig": "workspace:*",
    "electrobun": "catalog:",
    "typescript": "catalog:"
  }
}
