    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@uni-stack/api": "workspace:*",
    "@uni-stack/app": "workspace:*",
    "@uni-stack/core": "workspace:*",
    "@uni-stack/db": "workspace:*",
    "@uni-stack/env": "workspace:*",
    "@uni-stack/i18n": "workspace:*",
    "@uni-stack/logger": "workspace:*",
    "@uni-stack/seo": "workspace:*",
    "@uni-stack/ui": "workspace:*",
    "hono": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "catalog:",
