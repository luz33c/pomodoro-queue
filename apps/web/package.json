{
  "name": "@tsu-stack/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env IS_BUILD=true dotenvx run -f ../../packages/env/.env -- vite build",
    "check": "tsc --noEmit",
    "prebuild": "pnpm --dir ../.. --filter @tsu-stack/i18n run build",
    "predev": "pnpm --dir ../.. --filter @tsu-stack/i18n run build",
    "dev": "dotenvx run -f ../../packages/env/.env -- vite",
    "preview": "dotenvx run -f ../../packages/env/.env -- vite preview",
    "start": "dotenvx run -f ../../packages/env/.env -- node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "ui": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
    "@bprogress/react": "catalog:",
