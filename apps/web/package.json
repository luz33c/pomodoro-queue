{
  "name": "@uni-stack/web",
  "private": true,
  "files": [
    "dist",
    "server.ts"
  ],
  "type": "module",
  "imports": {
    "#/shared/providers/*": "./src/shared/providers/*.tsx",
    "#/shared/ui/*": "./src/shared/ui/*.tsx",
    "#/*.css": "./src/*.css",
    "#/*": "./src/*.ts"
  },
  "scripts": {
    "build": "cross-env IS_BUILD=true dotenvx run -f ../../packages/env/.env -- vite build",
    "check": "tsc --noEmit",
    "check:server": "cross-env NODE_ENV=production dotenvx run -f ../../packages/env/.env -- node scripts/check-server.mjs",
    "prebuild": "pnpm --dir ../.. run i18n:ensure",
    "predev": "pnpm --dir ../.. run i18n:ensure",
    "dev": "dotenvx run -f ../../packages/env/.env -- vite",
    "preview": "dotenvx run -f ../../packages/env/.env -- vite preview",
    "start": "cross-env NODE_ENV=production dotenvx run -f ../../packages/env/.env -- node server.ts",
    "typecheck": "tsc --noEmit",
    "ui": "pnpm dlx shadcn@latest"
  },
  "dependencies": {
    "@bprogress/react": "catalog:",
    "@clerk/localizations": "catalog:",
    "@clerk/tanstack-react-start": "catalog:",
