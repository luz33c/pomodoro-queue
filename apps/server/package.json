{
  "name": "@uni-stack/server",
  "type": "module",
  "main": "src/index.ts",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "cross-env IS_BUILD=true tsdown",
    "dev": "node --env-file=../../packages/env/.env --watch src/index.ts",
    "start": "dotenvx run -f ../../packages/env/.env -- node .output/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@hono/node-server": "catalog:",
    "@uni-stack/api": "workspace:*",
    "@uni-stack/db": "workspace:*",
    "@uni-stack/env": "workspace:*",
    "@uni-stack/logger": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uni-stack/tsconfig": "workspace:*",
    "cross-env": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
