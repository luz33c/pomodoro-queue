# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL=http://localhost:5000/server

# ✅ required - Public URL of the web app.
VITE_WEB_URL=http://localhost:3000/web

# ✅ required - Public URL of the product app (apps/app). Its path becomes the app's base path.
# To serve the app from the web service instead, set it under VITE_WEB_URL (http://localhost:3000/web/app);
# the web image then builds and serves the app, and the separate app service is unused.
VITE_APP_URL=http://localhost:3002/app

# ✅ required - Clerk secret key for server-side auth verification.
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-secret-key

# ✅ required - Clerk publishable key exposed to the web client.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-your-clerk-publishable-key

# ⚙️ optional - Additional allowed Clerk authorized parties for API bearer token validation.
# views://mainview is the packaged desktop app's origin.
CLERK_AUTHORIZED_PARTIES=views://mainview

# ✅ required - Full connection string. Must match the credentials in PostgreSQL config.
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/tsu-stack

# ✅ required - Shared secret between the server and the Electric sync service.
# The compose file points the server at http://electric:3000 itself, so ELECTRIC_URL is not set here.
ELECTRIC_SECRET=changeme-electric-secret

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=

# ⚙️ optional - imgproxy signature path segment. Defaults to "_" for unsigned imgproxy URLs.
# Use "insecure" or a precomputed signature string if your imgproxy setup requires it.
VITE_IMGPROXY_SIGNATURE=_

# ⚙️ optional - Host port for the web service.
WEB_PORT=3000

# ============================================================
# 📦 App
# ============================================================

# ⚙️ optional - Host port for the app service.
APP_PORT=3002

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS=false

# ⚙️ optional - Host port for the server service.
SERVER_PORT=5000

# ============================================================
# 🐘 PostgreSQL
# ============================================================

# ⚙️ optional
POSTGRES_USER=postgres

# ✅ required
POSTGRES_PASSWORD=changeme

# ⚙️ optional
POSTGRES_DB=tsu-stack
