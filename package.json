{
  "name": "uni-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check .",
    "lint:fix": "oxlint --fix --type-aware --type-check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "check": "pnpm run i18n:ensure && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "fix": "pnpm run i18n:ensure && pnpm run format && pnpm run lint:fix && pnpm run typecheck",
    "test": "pnpm run test:unit:run",
    "test:unit:run": "dotenvx run -f ./packages/env/.env -- pnpm -r --if-present run test:unit",
    "test:e2e:run": "dotenvx run -f ./packages/env/.env -- pnpm -r --if-present run test:e2e",
    "dev": "pnpm run i18n:ensure && pnpm --filter @uni-stack/i18n --filter @uni-stack/server --filter @uni-stack/web --filter @uni-stack/app --parallel run dev",
    "build": "pnpm --filter @uni-stack/i18n --filter @uni-stack/web --filter @uni-stack/app --filter @uni-stack/server --filter @uni-stack/extension --if-present run build",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "deps": "pnpm dlx taze@latest -Ilwr --maturity-period 3",
    "deps:major": "pnpm dlx taze@latest major -Ilwr --maturity-period 3",
    "build:desktop": "pnpm --filter @uni-stack/i18n run build && pnpm --filter @uni-stack/desktop run build:stable",
    "build:preview-ui": "pnpm --filter @uni-stack/preview-ui run build",
    "dev:desktop": "pnpm run i18n:ensure && pnpm --filter @uni-stack/app run build:desktop && pnpm --filter @uni-stack/app --filter @uni-stack/desktop --parallel run dev:desktop",
    "dev:extension": "pnpm --filter @uni-stack/extension run dev",
    "dev:native": "pnpm --filter @uni-stack/native run dev",
    "dev:preview-ui": "pnpm --filter @uni-stack/preview-ui run dev",
    "i18n:ensure": "node -e \"const { existsSync } = require('node:fs'); const { execFileSync } = require('node:child_process'); if (['messages/_index.js', 'messages.js', 'registry.js', 'runtime.js', 'server.js'].some((file) => !existsSync('packages/i18n/src/paraglide/' + file))) execFileSync('pnpm', ['--filter', '@uni-stack/i18n', 'run', 'build'], { stdio: 'inherit' })\"",
    "fallow": "pnpm dlx fallow --skip health",
    "tanstack": "pnpm dlx @tanstack/cli@latest",
    "db": "pnpm --filter @uni-stack/db run db",
    "db:dev:start": "pnpm --filter @uni-stack/db run db:dev:start",
    "db:dev:stop": "pnpm --filter @uni-stack/db run db:dev:stop",
    "db:push": "pnpm --filter @uni-stack/db run db push",
    "db:generate": "pnpm --filter @uni-stack/db run db generate",
    "db:migrate": "pnpm --filter @uni-stack/db run db migrate",
    "db:studio": "pnpm --filter @uni-stack/db run db studio",
    "docker:up": "dotenvx run -f .env.docker docker -- compose up",
    "docker:up:build": "dotenvx run -f .env.docker docker -- compose up --build",
    "docker:down": "dotenvx run -f .env.docker docker -- compose down",
    "ui": "pnpm --filter @uni-stack/ui run ui",
    "ui:web": "pnpm --filter @uni-stack/web run ui"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "eslint-plugin-fsd-lint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*": "oxfmt --check --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --type-aware"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.28.2"
  },
  "packageManager": "pnpm@11.28.2"
}
