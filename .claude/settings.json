{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["shadcn", "clerk", "expo"],
  "extraKnownMarketplaces": {
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  },
  "enabledPlugins": {
    "egm@egm": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r \".tool_response.filePath // .tool_input.file_path // empty\"); case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/*) \"$CLAUDE_PROJECT_DIR/node_modules/.bin/oxfmt\" --no-error-on-unmatched-pattern \"$f\" >/dev/null 2>&1 ;; esac; exit 0",
            "timeout": 30,
            "statusMessage": "Formatting with oxfmt"
          }
        ]
      }
    ]
  }
}
