{
  "name": "@tsu-stack/api",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./client/*": {
      "default": "./src/client/*.ts"
    },
    "./server/*": {
      "default": "./src/server/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "catalog:",
    "@clerk/tanstack-react-start": "catalog:",
    "@electric-sql/client": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/json-schema": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@orpc/zod": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@tsu-stack/core": "workspace:*",
    "@tsu-stack/db": "workspace:*",
    "@tsu-stack/env": "workspace:*",
    "@tsu-stack/logger": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsu-stack/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
