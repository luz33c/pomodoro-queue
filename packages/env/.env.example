# ============================================================
# 🔗 Shared
# ============================================================

# ✅ required - Public URL of the API server.
VITE_SERVER_URL="http://localhost:5000/server"

# ✅ required - Public URL of the web app.
VITE_WEB_URL="http://localhost:3000/web"

# ✅ required - Public URL of the product app (apps/app). Its path becomes the app's base path.
# Must share a root domain with VITE_WEB_URL in production, e.g. https://app.example.com next to https://example.com.
# Pointing it under VITE_WEB_URL (e.g. http://localhost:3000/web/app) makes the web app serve it there instead;
# `pnpm run dev` then proxies that path to the app dev server on :3002.
VITE_APP_URL="http://localhost:3002/app"

# ✅ required - PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/tsu-stack"

# ✅ required - Clerk secret key for server-side auth verification.
CLERK_SECRET_KEY="sk_test_replace-with-your-clerk-secret-key"

# ✅ required - Clerk publishable key exposed to the web client.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_replace-with-your-clerk-publishable-key"

# ⚙️ optional - Additional allowed Clerk authorized parties for API bearer token validation.
# VITE_WEB_URL and VITE_APP_URL are allowed automatically. Add extra origins here, such as a Chrome extension origin.
# Example: chrome-extension://abcdefghijklmnopabcdefghijklmnop
# The desktop app calls the API from views://mainview when packaged and from http://localhost:3003 in `pnpm run dev:desktop`.
CLERK_AUTHORIZED_PARTIES="views://mainview,http://localhost:3003"

# ⚙️ optional - Client ID of the public Clerk OAuth application used by the desktop app (apps/app desktop build).
# Create it with PKCE enabled, scopes "openid profile email offline_access", and these redirect URIs:
# http://127.0.0.1:47823/callback, http://127.0.0.1:47824/callback, http://127.0.0.1:47825/callback
# Leave empty to disable desktop sign-in.
VITE_CLERK_DESKTOP_CLIENT_ID=""

# ============================================================
# 🌍 Web
# ============================================================

# ⚙️ optional - Base URL for imgproxy. Leave empty to disable.
VITE_IMGPROXY_URL=""

# ⚙️ optional - imgproxy signature path segment. Defaults to "_" for unsigned imgproxy URLs.
# Use "insecure" or a precomputed signature string if your imgproxy setup requires it.
VITE_IMGPROXY_SIGNATURE="_"

# ============================================================
# 📱 Native
# ============================================================

# ✅ required - Public API URL for the Expo app.
EXPO_PUBLIC_SERVER_URL="http://localhost:5000/server"

# ✅ required - Clerk publishable key exposed to the Expo app.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace-with-your-clerk-publishable-key"

# ============================================================
# 🧩 Extension
# ============================================================

# ✅ required - Public API URL for the browser extension.
WXT_SERVER_URL="http://localhost:5000/server"

# ✅ required - Clerk publishable key exposed to the browser extension.
WXT_CLERK_PUBLISHABLE_KEY="pk_test_replace-with-your-clerk-publishable-key"

# ⚙️ optional - Clerk Frontend API URL copied from Clerk's Chrome Extension quick-copy block.
WXT_CLERK_FRONTEND_API=""

# ⚙️ optional - Host used by Clerk Sync Host. Use http://localhost in local development.
WXT_CLERK_SYNC_HOST="http://localhost"

# ⚙️ optional - Chrome extension manifest "key" for a stable CRX ID.
# This is not a Clerk key. Leave empty for quick local dev; Chrome will generate an extension ID.
# Fill this only when you need the ID to stay stable across rebuilds or machines.
# Keep the matching private .pem outside git, copy only the derived public key here locally,
# then add chrome-extension://<stable-id> to CLERK_AUTHORIZED_PARTIES and Clerk Allowed Origins.
WXT_EXTENSION_PUBLIC_KEY=""

# ============================================================
# 🖥️ Server
# ============================================================

# ⚙️ optional - Expose the OpenAPI /docs endpoint.
ENABLE_OPEN_API_DOCS="false"

# ============================================================
# 🔨 Build
# ============================================================

# ⚙️ optional - Git commit SHA injected at build time.
SOURCE_COMMIT=""
